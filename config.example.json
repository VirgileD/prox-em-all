{
    "listenEndpoint": "127.0.0.1:3129",
    "proxyPorts": [80, 443],
    "ipTableMark": 5,
    "noProxyList": ["172.16.0.0/12"],
    "relayingRedirectResponse": true,
    "logLevel": "info",
    "debugEndpoint": "",
    "rules": [
        {
            "name": "internal services, direct",
            "destinations": ["10.1.2.3", "10.20.0.0/16", ".*\\.internal\\.example\\.com"],
            "proxies": []
        },
        {
            "name": "partner network, through the partner proxy",
            "destinations": [".*\\.partner\\.example\\.net"],
            "proxies": ["http://partner-proxy.example.com:3128"]
        },
        {
            "name": "everything else, through the corporate proxies",
            "destinations": ["0.0.0.0/0"],
            "proxies": ["http://user:password@proxy.example.com:3128", "socks5://10.0.0.1:1080"]
        }
    ]
}
